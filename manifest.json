{
  "manifest_version": 3,
  "name": "LegitSeat",
  "version": "3.4.6",
  "description": "Highlights common warning signs on ticket-sale websites.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://legitseat-backend.onrender.com/*",
    "https://app.ticketmaster.com/*",
    "https://*.ticketmaster.com/*",
    "https://*.livenation.com/*",
    "https://api.seatgeek.com/*",
    "https://*.seatgeek.com/*",
    "https://*.tickpick.com/*",
    "https://*.stubhub.com/*",
    "https://*.vividseats.com/*",
    "https://*.viagogo.com/*",
    "https://gametime.co/*",
    "https://*.gametime.co/*",
    "https://*.axs.com/*",
    "https://api.tickets.dev/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": [
      "https://*.ticketmaster.com/*", "https://*.livenation.com/*", "https://*.seatgeek.com/*",
      "https://*.tickpick.com/*", "https://*.stubhub.com/*", "https://*.vividseats.com/*",
      "https://*.viagogo.com/*", "https://gametime.co/*", "https://*.gametime.co/*", "https://*.axs.com/*"
    ],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_title": "Check this ticket site with LegitSeat", "default_popup": "popup.html" },
  "options_page": "options.html",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
